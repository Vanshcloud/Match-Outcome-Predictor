# Everything the image does not need. Keeping this tight is not cosmetic: a
# build context that includes data/ and .venv/ uploads hundreds of megabytes to
# the daemon on every build.
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
# A coding agent's worktree: a second checkout of this repository inside it.
# Nothing COPYs it, but it was half of the 2.5 MB context every build uploaded.
.kilo/
.kilocode/

# data/ and models/ are mounted at run time, never built in. An image with a
# model baked in has to be rebuilt to retrain; one with the match table inside
# is hundreds of megabytes that change every match week.
data/
models/
mlruns/
mlartifacts/
notebooks/
docs/
tests/
scripts/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

.env
.env.*
# The dashboard image copies .streamlit/ for its config.toml; the optional
# sign-in's OIDC client secret and cookie secret must not ride along with it.
.streamlit/secrets.toml
# Local audit notes, kept out of the repository by .gitignore. No COPY reaches
# them, and they have no business in a build context either.
*_AUDIT_REPORT.md
*_PUBLICATION_REPORT.md
.DS_Store
