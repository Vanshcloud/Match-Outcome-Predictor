# Everything the image does not need. Keeping this tight is not cosmetic: a
# build context that includes data/ and .venv/ uploads hundreds of megabytes to
# the daemon on every build.
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# data/ and models/ are mounted at run time, never built in. An image with a
# model baked in has to be rebuilt to retrain; one with the match table inside
# is hundreds of megabytes that change every match week.
data/
models/
mlruns/
mlartifacts/
notebooks/
plans/
docs/
tests/
scripts/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

.env
.DS_Store
