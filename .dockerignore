# Everything the image does not need. Keeping this tight is not cosmetic: a
# build context that includes data/ and .venv/ uploads hundreds of megabytes to
# the daemon on every build.
.git/
.github/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

data/raw/
data/processed/
data/features/
models/
mlruns/
mlartifacts/
notebooks/
plans/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

.env
.DS_Store
