# Applied by the editor before any formatter runs, so a file is not reformatted
# on save into something `black --check` then rejects.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces is a hard line break in Markdown.
trim_trailing_whitespace = false
