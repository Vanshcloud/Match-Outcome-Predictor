# Copy to .env and edit. .env is gitignored; never commit real credentials.
#
# Every variable here is optional: each has a working default in
# configs/config.yaml, and a real environment variable outranks that file. That
# is the direction a container needs — override a committed default without
# rebuilding the image.
#
# Anything not listed here is not configurable by environment. src/utils/config
# maps an explicit set of variables and rejects unknown YAML keys outright, so
# a typo fails loudly instead of appearing to work.
#
# The provider this project *ingests* from (football-data.co.uk) serves static
# CSV over plain HTTPS with no key, no account and no rate limit, so nothing in
# the pipelines needs a credential. The dashboard's optional fixture feed
# (football-data.org — a different organisation with a confusingly similar
# name) does, and it is FOOTBALL_DATA_API_KEY below.

# ---- Paths (defaults are fine for local development) ------------------------
DATA_DIR=data
MODEL_DIR=models

# ---- Service ----------------------------------------------------------------
API_PORT=8000

# How many fixtures one /predict/batch request may ask for. Every fixture is a
# row of the same design matrix, so the cost is linear and an unbounded request
# is the cheapest denial of service there is.
API_MAX_BATCH=50

# How many priced fixtures the service holds before it evicts the oldest.
# The artefact and the feature table are both loaded once in the
# lifespan and never reloaded, so a match id names one design row that one
# fitted model turns into one triple of probabilities for the life of the
# process — the cache can only serve the same answer sooner, never a stale one.
# The timestamp is not cached: `predicted_at` is re-stamped on every response,
# because it says when this service answered.
#
# 0 switches it off, which is a real thing to want: a deployment measuring how
# long the estimators take wants every request to reach them.
API_PREDICTION_CACHE=1024

# Where served predictions are logged, so the model's calibration can be
# measured against what actually happened rather than assumed to match the
# backtest. Unset — as it is here — disables the log and the service runs with
# no database, which is the default and what CI does.
#
# A SECRET, like the API key and webhook URL below. It carries a password, which is why it is an
# environment variable with no counterpart in configs/config.yaml: that file is
# committed, and a setting that can only be supplied by environment is one
# nobody can commit by accident. The compose file supplies a development value.
#
# PREDICTION_LOG_DSN=postgresql://predictor:predictor@127.0.0.1:5432/predictions

# ---- Dashboard --------------------------------------------------------------
# Where the dashboard asks for a probability. Loopback is what `make api` and
# `make dashboard` produce side by side; compose overrides it to http://api:8000.
DASHBOARD_API_URL=http://127.0.0.1:8000

# Which fixture feed supplies today's matches, the coming week and live scores.
# Two are registered: `none` and `football-data.org`.
#
# `none` is the default and answers nothing on purpose: this project ingests
# **results**, so a match that has not been played is in no table here and the
# dashboard says which sections that empties rather than inventing a fixture.
#
# `football-data.org` is the live provider. It needs the key below, it
# covers nine of this project's thirty-nine competitions on the free tier, and
# nothing it returns is written to a table or read by a model — it answers the
# one question the results feed cannot, which is what is on tonight.
DASHBOARD_FIXTURE_PROVIDER=none

# The key for that feed. Free, instant, and rate-limited to ten calls a minute:
# register at https://www.football-data.org/client/register
#
# An environment variable with no counterpart in configs/config.yaml, for the
# reason PREDICTION_LOG_DSN is one: that file is committed, and a credential
# that can only arrive by environment is one nobody can commit by accident.
# Unset — as it is here — the provider reports itself unavailable and names
# this variable on the page, which is a configuration sentence rather than an
# outage.
#
# FOOTBALL_DATA_API_KEY=

# Which source supplies the registered squads on the match page. The same two
# names as above, and the same key — and its own variable, because a reader can
# want live scores and no squad panel, or the reverse.
#
# It is called `SQUAD` rather than `AVAILABILITY` on purpose:
# a registered squad is who the club has on its list, which is an upper bound
# on who is available. football-data.org has no injury endpoint at any tier,
# and its free plan answers even a finished match with an empty lineup and
# bench — measured, not assumed — so injuries and team sheets have no source
# and the page says so.
DASHBOARD_SQUAD_PROVIDER=none

# Where the dashboard keeps which leagues and clubs each reader follows.
# Unset, it is `<DATA_DIR>/dashboard/profiles.json`, which is right for a local
# run and wrong for the container — compose mounts `data/` read-only, so the
# image is given a writable volume and this variable points at it. A deployment
# that sets neither still works: the sidebar says the favourite could not be
# saved instead of losing the page.
#
# DASHBOARD_PROFILE_STORE=data/dashboard/profiles.json

# Accounts are optional and off unless a provider is configured. Streamlit's
# own OIDC login reads .streamlit/secrets.toml — which is gitignored and has no
# committed example, because every value in it is a credential — and needs
# `pip install streamlit[auth]`, which requirements-dashboard.txt deliberately
# does not install. With neither, the sidebar offers named profiles instead and
# says nothing about signing in.

# Where match events go: a goal, a kick-off, a final whistle for the clubs you
# follow. Two are registered, `none` and `webhook`.
#
# `none` is the default and delivers nothing, which is not a failure: the live
# strip toasts what changed whether or not a transport is configured, because
# the toast is in the page. This is the half that reaches a phone.
DASHBOARD_NOTIFIER=none

# The URL events are posted to. Slack, Discord, ntfy, Zapier and a script
# behind `nc -l` all accept the same thing — a POST with a JSON body — so the
# body carries `text` (Slack), `content` (Discord) and the event's own fields,
# and there is no "which flavour of webhook" setting to get wrong.
#
# A credential, not an address: anyone holding a Slack or Discord webhook URL
# can post as that integration. Environment only, like PREDICTION_LOG_DSN, and
# for the same reason — configs/config.yaml is committed.
#
# DASHBOARD_WEBHOOK_URL=

# DEBUG | INFO | WARNING | ERROR | CRITICAL. An unrecognised value fails at
# startup naming the setting, rather than deep inside logging.setLevel.
LOG_LEVEL=INFO
